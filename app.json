{
  "expo": {
    "name": "GOY XPRESS",
    "slug": "goy-xpress",
    "version": "3.2.0",
    "scheme": "goyxpress",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D2F41"
    },
    "android": {
      "package": "com.goyxpress.mensajeria",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D2F41"
      },
      "permissions": []
    },
    "ios": {
      "bundleIdentifier": "com.goyxpress.mensajeria",
      "buildNumber": "6"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "GOY XPRESS necesita acceso a tus fotos para personalizar tu perfil.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
