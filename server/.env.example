PORT=8787
ADMIN_EMAIL=tu-correo-administrador@ejemplo.com
ADMIN_PASSWORD=define-una-clave-segura-en-el-hosting
TOKEN_SECRET=genera-un-secreto-largo-y-aleatorio
DATABASE_URL=postgresql://usuario:clave@host/base
GOOGLE_MAPS_API_KEY=clave-restringida-de-google-maps-routes-api
ALLOWED_ORIGIN=http://localhost:8080
DATA_FILE=./data-v5.json

# OTP Mensajeros por correo (Brevo API)
BREVO_API_KEY=clave-api-brevo
BREVO_SENDER_EMAIL=remitente-verificado@ejemplo.com
BREVO_SENDER_NAME=GOY XPRESS

# OTP Mensajeros por WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=token-permanente-meta
WHATSAPP_PHONE_NUMBER_ID=id-numero-whatsapp-business
WHATSAPP_OTP_TEMPLATE=goy_xpress_codigo
WHATSAPP_OTP_TEMPLATE_LANG=es
WHATSAPP_GRAPH_VERSION=v25.0


# GOY SALES AI · primer contacto de prospectos
# Plantilla de Meta para el primer mensaje comercial.
GOY_WA_PROSPECT_TEMPLATE=goy_prospecto_primer_contacto
# Activa en true únicamente cuando esa plantilla tenga cabecera IMAGE aprobada en Meta.
# Mientras sea false, GOY SALES AI enviará el texto aprobado y registrará la imagen como pendiente.
GOY_WA_PROSPECT_MEDIA_HEADER=false

# WhatsApp transaccional de órdenes · plantillas aprobadas con cabecera IMAGE
GOY_WA_TEMPLATE_LANG=es
GOY_WA_ADMIN_ORDER_TEMPLATE=goy_nueva_orden_admin
GOY_WA_COURIER_ORDER_TEMPLATE=goy_nueva_orden_mensajero
GOY_WA_CLIENT_ORDER_TEMPLATE=goy_nueva_orden_cliente
GOY_WA_RECIPIENT_ORDER_TEMPLATE=goy_nueva_orden_destinatario
GOY_WA_CLIENT_DELIVERED_TEMPLATE=goy_entrega_finalizada_cliente
GOY_WA_ORDER_LOGO_URL=https://goy-xpress-app.kyrshopecu.workers.dev/assets/goy-logo.jpg
