{
  "expo": {
    "name": "GOY XPRESS Cliente",
    "slug": "goy-xpress-cliente",
    "version": "1.4.0",
    "scheme": "goyxpresscliente",
    "orientation": "portrait",
    "icon": "./assets/goy-logo.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D2F41"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "GOY XPRESS Cliente necesita acceso a tus imágenes únicamente para que puedas elegir el logotipo de tu empresa."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "GOY XPRESS Cliente necesita acceso a tus fotos únicamente para guardar las evidencias de tus órdenes.",
          "savePhotosPermission": "GOY XPRESS Cliente necesita permiso para guardar las evidencias de tus órdenes en el dispositivo."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0D2F41",
          "sounds": [
            "./assets/goy_xpress_event.mp3"
          ],
          "defaultChannel": "goy-orders"
        }
      ]
    ],
    "android": {
      "package": "com.goyxpress.cliente",
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/goy-logo.jpg",
        "backgroundColor": "#0D2F41"
      },
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": false,
      "permissions": [
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.goyxpress.cliente",
      "buildNumber": "14"
    }
  }
}
