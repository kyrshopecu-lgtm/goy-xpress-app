{
  "expo": {
    "name": "GOY XPRESS Cliente",
    "slug": "goy-xpress-cliente",
    "version": "1.3.5",
    "scheme": "goyxpresscliente",
    "orientation": "portrait",
    "icon": "./assets/goy-logo.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D2F41"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "GOY XPRESS Cliente necesita acceso a tus imágenes únicamente para que puedas elegir el logotipo de tu empresa."
        }
      ]
    ],
    "android": {
      "package": "com.goyxpress.cliente",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/goy-logo.jpg",
        "backgroundColor": "#0D2F41"
      },
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "com.goyxpress.cliente",
      "buildNumber": "9"
    }
  }
}
