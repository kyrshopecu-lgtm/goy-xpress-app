{
  "expo": {
    "name": "GOY XPRESS Mensajero",
    "slug": "goy-xpress-mensajero",
    "version": "1.5.1",
    "scheme": "goyxpressmensajero",
    "orientation": "portrait",
    "icon": "./assets/goy-logo.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D2F41"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "GOY XPRESS Mensajero necesita la cámara para tu foto de perfil y para registrar evidencias de recogida, servicios, depósitos y entrega.",
          "photosPermission": "GOY XPRESS Mensajero necesita acceso a tus imágenes únicamente para que puedas elegir tu foto de perfil."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GOY XPRESS Mensajero usa tu ubicación durante una operación activa para seguimiento exclusivo del administrador."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0D2F41",
          "sounds": [
            "./assets/goy_xpress_event.mp3"
          ],
          "defaultChannel": "goy-orders"
        }
      ]
    ],
    "android": {
      "package": "com.goyxpress.mensajero",
      "versionCode": 16,
      "adaptiveIcon": {
        "foregroundImage": "./assets/goy-logo.jpg",
        "backgroundColor": "#0D2F41"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "com.goyxpress.mensajero",
      "buildNumber": "16"
    }
  }
}
