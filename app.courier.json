{
  "expo": {
    "name": "GOY XPRESS Mensajero",
    "slug": "goy-xpress-mensajero",
    "version": "4.0.0",
    "scheme": "goyxpressmensajero",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {"image":"./assets/splash.png","resizeMode":"contain","backgroundColor":"#0D2F41"},
    "plugins": [
      ["expo-image-picker", {"cameraPermission":"GOY XPRESS Mensajero necesita la cámara para registrar evidencias de recogida, depósitos y entrega."}],
      ["expo-location", {"locationWhenInUsePermission":"GOY XPRESS Mensajero usa tu ubicación durante una operación activa para seguimiento exclusivo del administrador."}]
    ],
    "android": {
      "package": "com.goyxpress.mensajero",
      "versionCode": 1,
      "adaptiveIcon": {"foregroundImage":"./assets/adaptive-icon.png","backgroundColor":"#0D2F41"},
      "permissions": ["CAMERA","ACCESS_FINE_LOCATION","ACCESS_COARSE_LOCATION"]
    },
    "ios": {"bundleIdentifier":"com.goyxpress.mensajero","buildNumber":"1"}
  }
}
